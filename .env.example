# Copia este archivo como .env.local y rellena los valores de tu proyecto Supabase
# (Supabase > Project Settings > API). La clave "publishable" es pública por diseño:
# la seguridad la ponen las reglas RLS de la base de datos.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
